{
	"version": 1,
	"description": "Built-in Monolith light presets and read-back property sets. Every key under 'properties' is a canonical UPROPERTY name on the light COMPONENT and is written through UE reflection (FMonolithReflectionWalker), so nothing here is hardcoded in C++ and names track the engine rather than a C++ switch statement.",
	"customising": "Do NOT edit this file to add your own presets — it ships with the plugin and is overwritten on update. Drop any number of *.json files with the same shape into <Project>/Plugins/Monolith/Saved/Monolith/LightPresets/ instead. Presets there override built-ins with the same name, and extra 'readback' entries are appended.",

	"readback": {
		"common": [
			"Mobility",
			"Intensity",
			"LightColor",
			"CastShadows",
			"CastStaticShadows",
			"CastDynamicShadows",
			"bAffectsWorld",
			"IndirectLightingIntensity",
			"VolumetricScatteringIntensity"
		],
		"directional": [
			"Temperature",
			"bUseTemperature",
			"SpecularScale",
			"LightSourceAngle",
			"bAtmosphereSunLight",
			"DynamicShadowDistanceMovableLight",
			"DynamicShadowCascades"
		],
		"point": [
			"Temperature",
			"bUseTemperature",
			"SpecularScale",
			"IntensityUnits",
			"AttenuationRadius",
			"SourceRadius",
			"SoftSourceRadius",
			"SourceLength"
		],
		"spot": [
			"Temperature",
			"bUseTemperature",
			"SpecularScale",
			"IntensityUnits",
			"AttenuationRadius",
			"SourceRadius",
			"SoftSourceRadius",
			"SourceLength",
			"InnerConeAngle",
			"OuterConeAngle"
		],
		"rect": [
			"Temperature",
			"bUseTemperature",
			"SpecularScale",
			"IntensityUnits",
			"AttenuationRadius",
			"SourceWidth",
			"SourceHeight",
			"BarnDoorAngle",
			"BarnDoorLength"
		],
		"sky": [
			"SourceType",
			"SkyDistanceThreshold",
			"bLowerHemisphereIsBlack",
			"LowerHemisphereColor",
			"OcclusionMaxDistance"
		]
	},

	"presets": {
		"sun_midday": {
			"type": "directional",
			"description": "Clear overhead sun. Neutral-warm daylight, tight sun disc.",
			"properties": {
				"Intensity": 10.0,
				"Temperature": 5500.0,
				"bUseTemperature": true,
				"LightSourceAngle": 0.5357,
				"IndirectLightingIntensity": 1.0
			}
		},
		"sun_golden_hour": {
			"type": "directional",
			"description": "Low warm sun near sunset. Softer disc, lower intensity.",
			"properties": {
				"Intensity": 4.0,
				"Temperature": 3200.0,
				"bUseTemperature": true,
				"LightSourceAngle": 1.0,
				"IndirectLightingIntensity": 1.2
			}
		},
		"sun_overcast": {
			"type": "directional",
			"description": "Diffuse daylight through cloud. Very soft disc, weak direct term.",
			"properties": {
				"Intensity": 2.0,
				"Temperature": 6800.0,
				"bUseTemperature": true,
				"LightSourceAngle": 5.0,
				"IndirectLightingIntensity": 1.5
			}
		},
		"moonlight": {
			"type": "directional",
			"description": "Night key light. Cool and dim; expect exposure/eye-adaptation to carry it.",
			"properties": {
				"Intensity": 0.2,
				"Temperature": 8500.0,
				"bUseTemperature": true,
				"LightSourceAngle": 0.5357,
				"IndirectLightingIntensity": 0.5
			}
		},

