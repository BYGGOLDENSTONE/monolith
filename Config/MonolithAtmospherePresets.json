{
	"version": 1,
	"description": "Built-in Monolith atmosphere / global-illumination presets and read-back property sets. Every key under 'properties' is a canonical UPROPERTY name on the target struct or component for that type, written through UE reflection (FMonolithReflectionWalker) — nothing here is hardcoded in C++, so names track the engine instead of a C++ switch statement.",
	"customising": "Do NOT edit this file to add your own presets — it ships with the plugin and is overwritten on update. Drop any number of *.json files with the same shape into <Project>/Plugins/Monolith/Saved/Monolith/AtmospherePresets/ instead. Presets there override built-ins with the same name, and extra 'readback' entries are appended.",

	"type_targets": {
		"post_process": "FPostProcessSettings (APostProcessVolume::Settings) — override-aware: writing a key also enables its bOverride_<Key> flag",
		"lumen": "FPostProcessSettings, restricted to the Lumen / GI / reflection keys listed under readback.lumen",
		"height_fog": "UExponentialHeightFogComponent",
		"sky_atmosphere": "USkyAtmosphereComponent",
		"project": "URendererSettings — READ ONLY, diagnostic only. Monolith never writes project renderer settings."
	},

	"readback": {
		"post_process": [
			"AutoExposureMethod",
			"AutoExposureBias",
			"AutoExposureMinBrightness",
			"AutoExposureMaxBrightness",
			"AutoExposureSpeedUp",
			"AutoExposureSpeedDown",
			"BloomIntensity",
			"BloomThreshold",
			"VignetteIntensity",
			"FilmGrainIntensity",
			"MotionBlurAmount",
			"AmbientOcclusionIntensity",
			"AmbientOcclusionRadius",
			"ColorSaturation",
			"ColorContrast",
			"ColorGamma",
			"ColorGain",
			"ColorOffset",
			"WhiteTemp",
			"WhiteTint",
			"SceneFringeIntensity",
			"DepthOfFieldFocalDistance",
			"DepthOfFieldFstop"
		],
		"lumen": [
			"DynamicGlobalIlluminationMethod",
			"ReflectionMethod",
			"LumenSceneLightingQuality",
			"LumenSceneDetail",
			"LumenSceneViewDistance",
			"LumenSceneLightingUpdateSpeed",
			"LumenFinalGatherQuality",
			"LumenFinalGatherLightingUpdateSpeed",
			"LumenFinalGatherScreenTraces",
			"LumenMaxTraceDistance",
			"LumenDiffuseColorBoost",
			"LumenSkylightLeaking",
			"LumenSkylightLeakingTint",
			"LumenFullSkylightLeakingDistance",
			"LumenSurfaceCacheResolution",
			"LumenRayLightingMode",
			"LumenReflectionQuality",
			"LumenReflectionsScreenTraces",
			"LumenFrontLayerTranslucencyReflections",
			"LumenMaxRoughnessToTraceReflections",
			"LumenMaxReflectionBounces",
			"LumenMaxRefractionBounces"
		],
		"height_fog": [
			"FogDensity",
			"FogHeightFalloff",
			"FogInscatteringLuminance",
			"SkyAtmosphereAmbientContributionColorScale",
			"DirectionalInscatteringExponent",
			"DirectionalInscatteringStartDistance",
			"DirectionalInscatteringLuminance",
			"FogMaxOpacity",
			"StartDistance",
			"EndDistance",
			"FogCutoffDistance",
			"bEnableVolumetricFog",
			"VolumetricFogScatteringDistribution",
			"VolumetricFogAlbedo",
			"VolumetricFogEmissive",
			"VolumetricFogExtinctionScale",
			"VolumetricFogDistance",
			"VolumetricFogStartDistance",
			"VolumetricFogNearFadeInDistance",
			"VolumetricFogStaticLightingScatteringIntensity",
			"bOverrideLightColorsWithFogInscatteringColors"
		],
		"sky_atmosphere": [
			"BottomRadius",
			"AtmosphereHeight",
			"GroundAlbedo",
			"MultiScatteringFactor",
			"TraceSampleCountScale",
			"RayleighScatteringScale",
			"RayleighScattering",
			"RayleighExponentialDistribution",
			"MieScatteringScale",
			"MieScattering",
			"MieAbsorptionScale",
			"MieAbsorption",
			"MieAnisotropy",
			"MieExponentialDistribution",
			"OtherAbsorptionScale",
			"OtherAbsorption",
			"SkyLuminanceFactor",
			"AerialPespectiveViewDistanceScale",
			"HeightFogContribution",
			"TransmittanceMinLightElevationAngle",
			"AerialPerspectiveStartDepth"
		],
		"project": [
			"DynamicGlobalIllumination",
			"Reflections",
			"bUseHardwareRayTracingForLumen",
			"LumenRayLightingMode",
			"bEnableRayTracing",
			"bGenerateMeshDistanceFields",
			"bEnableMegaLights",
			"ShadowMapMethod"
		]
	},

	"presets": {
		"fog_clear": {
			"type": "height_fog",
			"description": "Barely-there haze. Use as a starting point when you want depth cueing but no visible fog.",
			"properties": {
				"FogDensity": 0.002,
				"FogHeightFalloff": 0.2,
				"FogMaxOpacity": 1.0,
				"StartDistance": 0.0,
				"bEnableVolumetricFog": false
			}
		},
		"fog_morning_haze": {
			"type": "height_fog",
			"description": "Soft warm morning haze hugging the ground. Non-volumetric, cheap.",
			"properties": {
				"FogDensity": 0.02,
				"FogHeightFalloff": 0.35,
				"FogMaxOpacity": 0.9,
				"StartDistance": 200.0,
				"FogInscatteringLuminance": { "R": 0.55, "G": 0.5, "B": 0.42, "A": 1.0 },
				"DirectionalInscatteringExponent": 4.0,
				"DirectionalInscatteringStartDistance": 1000.0,
				"bEnableVolumetricFog": false
			}
		},
		"fog_valley_thick": {
			"type": "height_fog",
			"description": "Dense low-lying valley fog with a hard height cutoff. Reads strongly from a high camera.",
			"properties": {
				"FogDensity": 0.08,
				"FogHeightFalloff": 0.8,
				"FogMaxOpacity": 1.0,
				"StartDistance": 0.0,
				"FogCutoffDistance": 0.0,
				"bEnableVolumetricFog": false
			}
		},
		"fog_volumetric_night": {
			"type": "height_fog",
			"description": "Volumetric night fog — light shafts and god rays from every shadow-casting light. Costs GPU time.",
			"properties": {
				"FogDensity": 0.03,
				"FogHeightFalloff": 0.2,
				"FogMaxOpacity": 1.0,
				"bEnableVolumetricFog": true,
				"VolumetricFogScatteringDistribution": 0.2,
				"VolumetricFogExtinctionScale": 1.0,
				"VolumetricFogDistance": 12000.0,
				"VolumetricFogStartDistance": 0.0
			}
		},
		"fog_horror_dense": {
			"type": "height_fog",
			"description": "Claustrophobic interior murk — short sight lines, strong volumetric scattering, no directional inscattering.",
			"properties": {
				"FogDensity": 0.15,
				"FogHeightFalloff": 0.05,
				"FogMaxOpacity": 1.0,
				"StartDistance": 0.0,
				"bEnableVolumetricFog": true,
				"VolumetricFogScatteringDistribution": 0.0,
				"VolumetricFogExtinctionScale": 2.0,
				"VolumetricFogDistance": 6000.0,
				"DirectionalInscatteringExponent": 64.0
			}
		},

		"sky_earth_default": {
			"type": "sky_atmosphere",
			"description": "Earth-like atmosphere at the engine reference scale. Neutral starting point.",
			"properties": {
				"BottomRadius": 6360.0,
				"AtmosphereHeight": 60.0,
				"MultiScatteringFactor": 1.0,
				"RayleighScatteringScale": 0.0331,
				"RayleighExponentialDistribution": 8.0,
				"MieScatteringScale": 0.003996,
				"MieAbsorptionScale": 0.000444,
				"MieAnisotropy": 0.8,
				"MieExponentialDistribution": 1.2,
				"HeightFogContribution": 1.0,
				"AerialPespectiveViewDistanceScale": 1.0
			}
		},
		"sky_thin_alien": {
			"type": "sky_atmosphere",
			"description": "Thin, high-altitude air — darker sky, weak blue scatter, long visibility.",
			"properties": {
				"BottomRadius": 6360.0,
				"AtmosphereHeight": 30.0,
				"MultiScatteringFactor": 0.5,
				"RayleighScatteringScale": 0.012,
				"RayleighExponentialDistribution": 12.0,
				"MieScatteringScale": 0.001,
				"MieAbsorptionScale": 0.0002,
				"MieAnisotropy": 0.7,
				"HeightFogContribution": 0.5,
				"AerialPespectiveViewDistanceScale": 0.5
			}
		},
		"sky_dusty": {
			"type": "sky_atmosphere",
			"description": "Dust- and smoke-loaded air. Mie-heavy: hazy horizon, strong glow around the sun.",
			"properties": {
				"BottomRadius": 6360.0,
				"AtmosphereHeight": 60.0,
				"MultiScatteringFactor": 1.0,
				"RayleighScatteringScale": 0.02,
				"MieScatteringScale": 0.02,
				"MieAbsorptionScale": 0.004,
				"MieAnisotropy": 0.85,
				"MieExponentialDistribution": 3.0,
				"HeightFogContribution": 1.0,
				"AerialPespectiveViewDistanceScale": 2.0
			}
		},

		"look_neutral_manual_exposure": {
			"type": "post_process",
			"description": "Locks exposure so lighting edits are judged on real values instead of eye adaptation. Do this FIRST when lighting a level.",
			"properties": {
				"AutoExposureMethod": "AEM_Manual",
				"AutoExposureBias": 0.0,
				"BloomIntensity": 0.4,
				"VignetteIntensity": 0.0,
				"FilmGrainIntensity": 0.0,
				"MotionBlurAmount": 0.0
			}
		},
		"look_cinematic": {
			"type": "post_process",
			"description": "Filmic grade: soft bloom, gentle vignette, slight grain, shallow-ish depth of field.",
			"properties": {
				"BloomIntensity": 0.9,
				"BloomThreshold": -1.0,
				"VignetteIntensity": 0.5,
				"FilmGrainIntensity": 0.2,
				"SceneFringeIntensity": 0.5,
				"MotionBlurAmount": 0.5,
				"DepthOfFieldFstop": 2.8
			}
		},
		"look_horror_cold": {
			"type": "post_process",
			"description": "Desaturated, cold, heavy vignette and grain. Pairs with fog_horror_dense.",
			"properties": {
				"BloomIntensity": 0.3,
				"VignetteIntensity": 1.0,
				"FilmGrainIntensity": 0.6,
				"WhiteTemp": 4500.0,
				"WhiteTint": 0.0,
				"ColorSaturation": { "X": 0.6, "Y": 0.6, "Z": 0.65, "W": 1.0 },
				"ColorContrast": { "X": 1.1, "Y": 1.1, "Z": 1.1, "W": 1.0 },
				"AmbientOcclusionIntensity": 0.8,
				"AmbientOcclusionRadius": 120.0
			}
		},

		"lumen_off": {
			"type": "lumen",
			"description": "Turns dynamic GI and reflections off inside this volume. Use to isolate direct lighting while debugging.",
			"properties": {
				"DynamicGlobalIlluminationMethod": "None",
				"ReflectionMethod": "None"
			}
		},
		"lumen_balanced": {
			"type": "lumen",
			"description": "Engine-default-ish Lumen. Good baseline for gameplay levels.",
			"properties": {
				"DynamicGlobalIlluminationMethod": "Lumen",
				"ReflectionMethod": "Lumen",
				"LumenSceneLightingQuality": 1.0,
				"LumenSceneDetail": 1.0,
				"LumenFinalGatherQuality": 1.0,
				"LumenReflectionQuality": 1.0,
				"LumenMaxTraceDistance": 20000.0,
				"LumenFinalGatherScreenTraces": true,
				"LumenReflectionsScreenTraces": true
			}
		},
		"lumen_high_quality": {
			"type": "lumen",
			"description": "Higher fidelity Lumen for cinematics and screenshots. Noticeably more expensive.",
			"properties": {
				"DynamicGlobalIlluminationMethod": "Lumen",
				"ReflectionMethod": "Lumen",
				"LumenSceneLightingQuality": 2.0,
				"LumenSceneDetail": 2.0,
				"LumenSceneViewDistance": 40000.0,
				"LumenFinalGatherQuality": 2.0,
				"LumenReflectionQuality": 2.0,
				"LumenMaxTraceDistance": 40000.0,
				"LumenMaxReflectionBounces": 2,
				"LumenMaxRoughnessToTraceReflections": 0.6,
				"LumenSurfaceCacheResolution": 1.0
			}
		},
		"lumen_performance": {
			"type": "lumen",
			"description": "Cheapest Lumen that still reads as GI. For large open areas or lower-end targets.",
			"properties": {
				"DynamicGlobalIlluminationMethod": "Lumen",
				"ReflectionMethod": "Lumen",
				"LumenSceneLightingQuality": 0.5,
				"LumenSceneDetail": 0.5,
				"LumenSceneViewDistance": 10000.0,
				"LumenFinalGatherQuality": 0.5,
				"LumenReflectionQuality": 0.5,
				"LumenMaxTraceDistance": 10000.0,
				"LumenMaxReflectionBounces": 1
			}
		},
		"lumen_interior_no_leak": {
			"type": "lumen",
			"description": "Interior tuning: kills skylight leaking through walls and shortens trace distance so light stays in the room.",
			"properties": {
				"DynamicGlobalIlluminationMethod": "Lumen",
				"ReflectionMethod": "Lumen",
				"LumenSkylightLeaking": 0.0,
				"LumenFullSkylightLeakingDistance": 100.0,
				"LumenMaxTraceDistance": 5000.0,
				"LumenSceneDetail": 2.0,
				"LumenFinalGatherQuality": 1.5
			}
		}
	}
}
